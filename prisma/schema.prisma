generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Investor {
  id             String          @id @default(cuid())
  name           String
  email          String?
  phone          String?
  notes          String?
  floorplanLines FloorplanLine[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model FloorplanLine {
  id           String        @id @default(cuid())
  investorId   String
  investor     Investor      @relation(fields: [investorId], references: [id])
  name         String
  creditLimit  Decimal       @db.Decimal(12, 2)
  status       String        @default("active")
  vehicles     Vehicle[]
  transactions Transaction[]
  payments     Payment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Vehicle {
  id              String        @id @default(cuid())
  floorplanLineId String
  floorplanLine   FloorplanLine @relation(fields: [floorplanLineId], references: [id])
  vin             String        @unique
  year            Int
  make            String
  model           String
  trim            String?
  mileage         Int?
  purchasePrice   Decimal       @db.Decimal(10, 2)
  advanceAmount   Decimal       @db.Decimal(10, 2)
  purchaseDate    DateTime
  source          String?
  stockNumber     String?
  salePrice       Decimal?      @db.Decimal(10, 2)
  saleDate        DateTime?
  buyerName       String?
  status          String        @default("active") // active, paid_off, repo
  paidOffDate     DateTime?
  transactions    Transaction[]
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([floorplanLineId])
}

model Transaction {
  id              String        @id @default(cuid())
  floorplanLineId String
  floorplanLine   FloorplanLine @relation(fields: [floorplanLineId], references: [id])
  vehicleId       String?
  vehicle         Vehicle?      @relation(fields: [vehicleId], references: [id])
  paymentId       String?
  payment         Payment?      @relation(fields: [paymentId], references: [id])
  type            String // advance, payoff, adjustment
  amount          Decimal       @db.Decimal(10, 2)
  date            DateTime      @default(now())
  description     String?
  createdAt       DateTime      @default(now())

  @@index([type])
  @@index([vehicleId])
  @@index([date])
}

model Payment {
  id              String        @id @default(cuid())
  floorplanLineId String
  floorplanLine   FloorplanLine @relation(fields: [floorplanLineId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  date            DateTime
  method          String?
  reference       String?
  notes           String?
  transactions    Transaction[]
  createdAt       DateTime      @default(now())
}
